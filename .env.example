VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SENTRY_DSN=
VITE_LOG_LEVEL=warn
VITE_STRIPE_PUBLIC_KEY=pk_test_your-stripe-public-key
VITE_STRIPE_PRO_PRICE_ID=price_your-pro-plan-price-id

# Feature flags (mocks — leave off until real implementations exist)
# Voice commands are a mock; leave off until STT is implemented (audit P1-4).
VITE_ENABLE_VOICE_COMMANDS=false
# Feature flag for the dubbing module (kill-switch); keep false until rollout.
VITE_ENABLE_DUBBING=false

# Edge Function Secrets (Do not expose to Vite/frontend)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# AI via OpenRouter gateway. Region-safe models ONLY (no OpenAI / Google / Anthropic).
AI_API_KEY=your-openrouter-key
AI_MODEL_NAME=moonshotai/kimi-k2.6
FALLBACK_MODEL_NAME=deepseek/deepseek-chat
VISION_MODEL_NAME=qwen/qwen3-vl-235b-a22b-instruct
FALLBACK_VISION_MODEL_NAME=qwen/qwen2.5-vl-72b-instruct
ELEVENLABS_API_KEY=your-elevenlabs-key
# TTS voice chain (2026-08-08 upgrade). Primary: Qwen TTS via OpenRouter
# /audio/speech (bilingual EN + zh-CN, reuses AI_API_KEY). ElevenLabs stays
# as the fallback provider — all optional, code defaults apply.
TTS_PROVIDER=openrouter
TTS_FALLBACK_CHAIN=openrouter,elevenlabs
OPENROUTER_TTS_MODEL=qwen/qwen-audio-3.0-tts-flash
OPENROUTER_TTS_VOICE_EN=Jennifer
OPENROUTER_TTS_VOICE_ZH=Cherry
# OPENROUTER_TTS_VOICE=Cherry   # optional single-voice override (both langs)
# TTS_MODEL_ID=eleven_flash_v2_5  # ElevenLabs model used when that provider runs
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret
STRIPE_PRO_PRICE_ID=price_your-pro-plan-price-id

NODE_ENV=development
